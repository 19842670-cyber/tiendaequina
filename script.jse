/* =========================
   CUESTIONARIO
========================= */

function calificar() {

    let preguntas = [

        "p1",
        "p2",
        "p3",
        "p4",
        "p5"

    ];


    let puntos = 0;


    preguntas.forEach(function(pregunta) {

        let respuesta =
            document.querySelector(
                'input[name="' + pregunta + '"]:checked'
            );


        if (respuesta) {

            puntos += Number(respuesta.value);

        }

    });


    let resultado =
        document.getElementById("resultado");


    resultado.innerHTML =
        "Tu resultado es: " +
        puntos +
        " de 5";


    if (puntos === 5) {

        resultado.innerHTML +=
            "<br>🏆 ¡Excelente trabajo!";

    }

    else if (puntos >= 3) {

        resultado.innerHTML +=
            "<br>👍 ¡Buen trabajo!";

    }

    else {

        resultado.innerHTML +=
            "<br>📚 Sigue estudiando.";

    }

}


/* =========================
   ANIMACIÓN AL HACER SCROLL
========================= */

window.addEventListener("scroll", function() {

    let elementos =
        document.querySelectorAll(".equi-card, .google-card");


    elementos.forEach(function(elemento) {

        let posicion =
            elemento.getBoundingClientRect().top;

        let pantalla =
            window.innerHeight;


        if (posicion < pantalla - 80) {

            elemento.style.opacity = "1";

        }

    });

     });